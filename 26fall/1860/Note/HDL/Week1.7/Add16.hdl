/*
 * Adds two 16-bit values.
 * The most-significant carry bit is ignored.
 */
 
CHIP Add16 {
    IN x[16], y[16];
    OUT out[16];

    PARTS:
    FullAdder(a=x[0] , b=y[0] , c=false , sum= out[0], carry=c0 );
    FullAdder(a=x[1] , b=y[1] , c=c0 , sum= out[1], carry=c1 );
    FullAdder(a=x[2] , b=y[2] , c=c1 , sum= out[2], carry=c2 );
    FullAdder(a=x[3] , b=y[3] , c=c2 , sum= out[3], carry=c3 );

    FullAdder(a=x[4] , b=y[4] , c=c3 , sum= out[4], carry=c4 );
    FullAdder(a=x[5] , b=y[5] , c=c4 , sum= out[5], carry=c5 );
    FullAdder(a=x[6] , b=y[6] , c=c5 , sum= out[6], carry=c6 );
    FullAdder(a=x[7] , b=y[7] , c=c6 , sum= out[7], carry=c7 );

    FullAdder(a=x[8] , b=y[8] , c=c7 , sum= out[8], carry=c8 );
    FullAdder(a=x[9] , b=y[9] , c=c8 , sum= out[9], carry=c9 );
    FullAdder(a=x[10], b=y[10], c=c9 , sum= out[10], carry=c10);
    FullAdder(a=x[11], b=y[11], c=c10, sum= out[11], carry=c11);

    FullAdder(a=x[12], b=y[12], c=c11, sum= out[12], carry=c12 );
    FullAdder(a=x[13], b=y[13], c=c12, sum= out[13], carry=c13 );
    FullAdder(a=x[14], b=y[14], c=c13, sum= out[14], carry=c14);
    FullAdder(a=x[15], b=y[15], c=c14, sum= out[15], carry=c15);
}
