/**
 * The ALU. Computes one of the following functions:
 * a+b, a-b, b-a, 0, 1, -1, a, b, -a, -b, !a, !b,
 * a+1, b+1, a-1, b-1, a&b, a|b on two 16-bit inputs,
 * according to 6 input bits denoted za,na,zb,nb,f,no.
 * The bit-combinations that yield each function are
 * documented in the book. In addition, the ALU
 * computes two 1-bit outputs: if the ALU output
 * is 0, zr is set to 1; otherwise zr is set to 0;
 * If out<0, ng is set to 1; otherwise ng is set to 0.
 */

// Implementation: the ALU manipulates the a and b
// inputs and then operates on the resulting values,
// as follows:
// if (za==1) set a = 0        // 16-bit constant
// if (na==1) set a = ~a       // bitwise "not"
// if (zb==1) set b = 0        // 16-bit constant
// if (nb==1) set b = ~b       // bitwise "not"
// if (f==1)  set out = a + b  // integer 2's complement addition
// if (f==0)  set out = a & b  // bitwise "and"
// if (no==1) set out = ~out   // bitwise "not"
// if (out==0) set zr = 1
// if (out<0) set ng = 1


CHIP ALU {
    IN
        a[16], b[16],  // 16-bit inputs
        za, // zero the a input?
        na, // negate the a input?
        zb, // zero the b input?
        nb, // negate the b input?
        f,  // compute  out = a + b (if 1) or out = a & b (if 0)
        no; // negate the out output?

    OUT
        out[16], // 16-bit output
        zr, // 1 if (out==0), 0 otherwise
        ng; // 1 if (out<0),  0 otherwise

    PARTS:

    // a input processing, controlled by the 'za' and 'na' bits
    

    // b input processing, controlled by the 'zb' and 'nb' bits
   

    // Compute both functions and select based on the 'f' bit
   

    // Output inversion, controlled by the 'no' bit
    // 'out' bit 15 is the 'ng' flag
   
