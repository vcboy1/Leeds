CHIP Mux16bits2way {
    IN a[16], b[16],sel;
    OUT out[16];


    PARTS:

    //  实现方法一： 直接用门电路实现
    
        Not16(in[0]=sel,in[1]=sel,in[2]=sel,in[3]=sel, 
              in[4]=sel,in[5]=sel,in[6]=sel,in[7]=sel, 
              in[8]=sel,in[9]=sel,in[10]=sel,in[11]=sel, 
              in[12]=sel,in[13]=sel,in[14]=sel,in[15]=sel, 
              out=notSel16 );

        Not16(in=notSel16,out=sel16);
        And16(a=a,b=notSel16,out= outA16 );
        And16(a=b,b=sel16,out= outB16 );
        Or16(a=outA16,b=outB16,out=out);

