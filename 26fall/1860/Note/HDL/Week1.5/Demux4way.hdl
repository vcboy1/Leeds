CHIP Demux4way {
    IN in, sel[2];
    OUT a, b, c, d;

    PARTS:
    DMux(in=in , sel=sel[1] , a= out0x, b= out1x);
    DMux(in=in , sel=sel[0] , a= outx0, b= outx1 );

    And(a= out0x, b= outx0, out=a );
    And(a= out0x, b= outx1, out=b );
    And(a= out1x, b= outx0, out=c );
    And(a= out1x, b= outx1, out=d );
}